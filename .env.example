# bing-ads-mcp-server configuration. See the README for how to obtain each value.
# Every value stays on this machine and is sent only to Microsoft (or Google,
# for Google-authenticated users).

# Your Microsoft Advertising developer token. Required in production.
# The sandbox always uses Microsoft's universal sandbox token instead.
BING_ADS_DEVELOPER_TOKEN=

# Application (client) ID of your Microsoft Entra app registration.
BING_ADS_CLIENT_ID=

# Client secret, only for a web app registration. Leave empty for a public
# (mobile and desktop) app registration.
# BING_ADS_CLIENT_SECRET=

# Refresh token obtained once through Microsoft's consent flow, with the
# https://ads.microsoft.com/msads.manage and offline_access scopes.
# The server renews access tokens in memory and never writes a token to disk.
BING_ADS_REFRESH_TOKEN=

# Customer ID that owns the accounts below (cid in the web app URL).
BING_ADS_CUSTOMER_ID=

# Required allowlist: comma-separated numeric account IDs (aid in the web app
# URL). Write accountId:customerId for an account owned by another customer.
BING_ADS_ACCOUNT_IDS=

# production (default) or sandbox. Each environment needs its own credentials.
BING_ADS_ENVIRONMENT=production

# Microsoft (default) or Google, for users who sign in to Microsoft Advertising
# with a Google account. Google requires BING_ADS_CLIENT_SECRET.
# BING_ADS_IDENTITY_PROVIDER=Microsoft

# Microsoft Entra tenant used for the token endpoint. Defaults to common.
# BING_ADS_OAUTH_TENANT=common

# Write tools are off by default. Only the exact value true exposes them.
# Every write still previews first and applies only on a second call with
# confirm: true.
BING_ADS_ENABLE_WRITES=false
